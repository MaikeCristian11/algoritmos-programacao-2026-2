// Este algoritmo nem chega a executar.
// Leia a mensagem que o VisuAlg mostra e corrija.
algoritmo "bug3"
var
   base, altura: real
inicio
   area: real

   escreva("Base: ")
   leia(base)
   escreva("Altura: ")
   leia(altura)

   area <- base * altura

   escreval("Area: ", area:6:2)
fimalgoritmo
