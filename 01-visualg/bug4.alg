// Este algoritmo roda, pede os dois valores, e depois nao mostra nada.
// Descubra por que e corrija.
algoritmo "bug4"
var
   distancia, litros, consumo: real
inicio
   escreva("Distancia (km): ")
   leia(distancia)
   escreva("Litros gastos: ")
   leia(litros)

   consumo <- distancia / litros
fimalgoritmo
